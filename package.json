{
  "name": "ea-meme-trader",
  "version": "0.1.0",
  "description": "EA Drawing: a Chrome extension that draws ATH lines, a Fib retracement and an Anchored VWAP on the DEX Screener chart from daily bars.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ext:build": "node extension/build.mjs",
    "ext:watch": "node extension/build.mjs --watch",
    "ext:zip": "node extension/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.0"
  }
}
